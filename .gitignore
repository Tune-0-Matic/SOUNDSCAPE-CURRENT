.godot/
.import/
.DS_Store
Thumbs.db

# Tracked deliberately (2026-09-17): the preset carries the export path, the icon and the
# version fields a release is built from, and it holds no keys -- encryption is off and both
# codesign identities are empty. Re-check that before adding a signing identity or a PCK key.
!export_presets.cfg

# --- GDExtension (Phase 9) ---------------------------------------------------
# Vendored dependency: cloned, never committed. See extension/STEP0.md for the
# pinned commit -- that is what makes the build reproducible, not a checked-in copy.
extension/godot-cpp/
# SCons intermediates: rebuilt from source, never shipped.
extension/.sconsign.dblite
extension/**/*.o
extension/**/*.os
extension/**/*.obj

# bin/ is a build output directory, but the compiled extension IS a release artifact: a fresh
# clone without it cannot play FLAC or DSD at all and falls back to 16-bit WAV. The built
# libraries are therefore tracked; everything else a build leaves here (import libraries,
# symbol files, SCons intermediates) is not.
#
# The .so pair comes off the Linux CI runner (.github/workflows/build-linux.yml), because this
# project is developed on Windows and cannot produce ELF. Without this line they would land in
# bin/, be ignored, and the Linux export would go on failing with no sign of why.
bin/*
!bin/libsoundscape_dsp.*.dll
!bin/libsoundscape_dsp.*.so
